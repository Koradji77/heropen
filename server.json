{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "net.heropen/heropen",
  "title": "heropen — AI Agent Memory",
  "description": "Persistent memory for AI agents: local-first MCP server, zero-config. No cloud, no API keys.",
  "version": "1.9.6",
  "websiteUrl": "https://heropen.net",
  "repository": {
    "url": "https://github.com/Koradji77/heropen",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "heropen",
      "version": "1.9.6",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "valueHint": "command",
          "description": "CLI subcommand that starts the heropen MCP server on stdio"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
